<?xml version="1.0" encoding="utf-8"?>
<!-- Default Chart model picker option(s) (mirrors blueprint graph / primary). -->
<odoo noupdate="1">
    <record id="graph_variant_salesperson_360_crm_lead" model="dashboard.blueprint.graph.variant">
        <field name="blueprint_id" ref="blueprint_salesperson_360"/>
        <field name="sequence">10</field>
        <field name="is_default" eval="True"/>
        <field name="graph_model">crm.lead</field>
        <field name="graph_data_field">user_id</field>
        <field name="primary_button_label">Pipeline Analysis</field>
        <field name="primary_action_xmlid">crm.crm_lead_action_pipeline</field>
        <field name="primary_action_context">{"default_type": {"__de__": "group_value", "default": "opportunity", "map": [{"groups": ["crm.group_use_lead"], "value": "lead"}]}}</field>
    </record>

</odoo>
