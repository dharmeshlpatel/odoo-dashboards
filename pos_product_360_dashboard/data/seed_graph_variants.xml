    <record id="graph_variant_pos_product_360_pos_order_line" model="dashboard.blueprint.graph.variant">
        <field name="blueprint_id" ref="blueprint_pos_product_360"/>
        <field name="sequence">10</field>
        <field name="is_default" eval="True"/>
        <field name="graph_model">pos.order.line</field>
