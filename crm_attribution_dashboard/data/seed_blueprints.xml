        <field name="relate_field">campaign_id</field>
        <field name="compute_domain">[('type', '=', 'opportunity'), ('active', '=', False), ('probability', '=', 0)]</field>
        <field name="compute_aggregator">__count</field>
        <field name="action_xmlid">crm.crm_lead_action_pipeline</field>
        <field name="action_domain">[('campaign_id', '=', '{{id}}'), ('active', '=', False)]</field>
    </record>
    <record id="slot_crm_campaign_bottom_opps" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_crm_campaigns"/>
        <field name="key">bottom_opportunities</field>
        <field name="name">Opportunities</field>
        <field name="section">bottom</field>
