<?xml version="1.0" encoding="utf-8"?>
<!--
  Customer 360 hub: lenses + compose Share Links.
  Pipeline / Leads / My Pipeline live on crm_customer_dashboard.
-->
<odoo noupdate="1">
    <record id="blueprint_customer_360" model="dashboard.blueprint">
        <field name="name">Customer 360</field>
        <field name="key">customer_360</field>
        <field name="host_model_id" ref="base.model_res_partner"/>
        <field name="module_depends" eval="False"/>
        <field name="menu_name">Customer 360</field>
        <field name="hub_id" ref="dashboard_engine.dashboard_hub_default"/>
        <field name="group_id" eval="False"/>
        <field name="is_compose_hub" eval="True"/>
        <field name="menu_parent_xmlid" eval="False"/>
        <field name="menu_sequence">5</field>
        <field name="graph_data_field">partner_id</field>
        <field name="graph_domain">[]</field>
        <field name="lens_my_enabled" eval="True"/>
        <field name="lens_my_default" eval="False"/>
        <field name="lens_my_label">My Partners</field>
        <field name="lens_kpis_enabled" eval="True"/>
        <field name="lens_kpis_default" eval="True"/>
        <field name="lens_kpis_label">With KPIs</field>
        <field name="lens_attention_enabled" eval="True"/>
        <field name="lens_attention_default" eval="True"/>
        <field name="lens_attention_label">Needs attention</field>
        <field name="state">published</field>
        <field name="sequence">5</field>
        <field name="include_child_records" eval="True"/>
    </record>
</odoo>
