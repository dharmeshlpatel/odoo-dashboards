<?xml version="1.0" encoding="utf-8"?>
<!-- Default Chart model picker option(s) (mirrors blueprint graph / primary). -->
<odoo noupdate="1">
    <record id="graph_variant_stock_products_stock_quant" model="dashboard.blueprint.graph.variant">
        <field name="blueprint_id" ref="blueprint_stock_products"/>
        <field name="sequence">10</field>
        <field name="is_default" eval="True"/>
        <field name="graph_model">stock.quant</field>
        <field name="graph_data_field">product_id</field>
        <field name="primary_button_label">Inventory</field>
        <field name="primary_action_xmlid">stock.action_view_inventory_tree</field>
        <field name="primary_action_context">{}</field>
    </record>

</odoo>
