<?xml version="1.0" encoding="utf-8"?>
<!--
  Stock Products daily on product.product.
  On Hand / Reserved are Footer · Totals (button_box), not Right · KPIs —
  avoids duplicating Sales Products box_on_hand when shared in Product 360.
-->
<odoo noupdate="1">
    <record id="blueprint_stock_products" model="dashboard.blueprint">
        <field name="name">Stock Products</field>
        <field name="key">stock_products</field>
        <field name="host_model_id" ref="product.model_product_product"/>
        <field name="module_depends">stock,product</field>
        <field name="menu_name">Products Dashboard</field>
        <field name="menu_parent_xmlid">stock.menu_warehouse_report</field>
        <field name="menu_sequence">45</field>
        <field name="primary_button_label">Inventory</field>
        <field name="primary_action_xmlid">stock.action_view_inventory_tree</field>
        <field name="graph_model">stock.quant</field>
        <field name="graph_data_field">product_id</field>
        <field name="graph_measure">quantity:sum</field>
        <field name="graph_groupby">location_id</field>
        <field name="graph_domain">[('location_id.usage', '=', 'internal')]</field>
        <field name="graph_caption">On hand by location</field>
        <field name="lens_my_enabled" eval="False"/>
        <field name="lens_kpis_enabled" eval="True"/>
        <field name="lens_kpis_default" eval="True"/>
        <field name="lens_kpis_label">With KPIs</field>
        <field name="lens_attention_enabled" eval="True"/>
        <field name="lens_attention_default" eval="True"/>
        <field name="lens_attention_label">Needs attention</field>
        <field name="state">draft</field>
        <field name="sequence">42</field>
    </record>

    <!-- KPI (right): moves / pickings awaiting, not qty totals -->
    <record id="slot_stprod_outgoing" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_stock_products"/>
        <field name="key">outgoing_moves</field>
        <field name="name">Outgoing Moves</field>
        <field name="section">kpi</field>
        <field name="sequence">10</field>
        <field name="label">Outgoing Move</field>
        <field name="label_plural">Outgoing Moves</field>
        <field name="compute_model">stock.move</field>
        <field name="relate_field">product_id</field>
        <field name="compute_domain">[('picking_type_id.code', '=', 'outgoing'), ('state', 'not in', ('done', 'cancel'))]</field>
        <field name="compute_aggregator">__count</field>
        <field name="style">warning</field>
        <field name="style_mode">when_positive</field>
        <field name="is_attention_signal" eval="True"/>
        <field name="action_xmlid">stock.stock_move_action</field>
        <field name="action_domain">[('product_id', '=', '{{id}}'), ('picking_type_id.code', '=', 'outgoing'), ('state', 'not in', ('done', 'cancel'))]</field>
        <field name="module_depends">stock</field>
    </record>
    <record id="slot_stprod_incoming" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_stock_products"/>
        <field name="key">incoming_moves</field>
        <field name="name">Incoming Moves</field>
        <field name="section">kpi</field>
        <field name="sequence">20</field>
        <field name="label">Incoming Move</field>
        <field name="label_plural">Incoming Moves</field>
        <field name="compute_model">stock.move</field>
        <field name="relate_field">product_id</field>
        <field name="compute_domain">[('picking_type_id.code', '=', 'incoming'), ('state', 'not in', ('done', 'cancel'))]</field>
        <field name="compute_aggregator">__count</field>
        <field name="action_xmlid">stock.stock_move_action</field>
        <field name="action_domain">[('product_id', '=', '{{id}}'), ('picking_type_id.code', '=', 'incoming'), ('state', 'not in', ('done', 'cancel'))]</field>
        <field name="module_depends">stock</field>
    </record>

    <!-- Smart buttons (button_box): On Hand + Reserved -->
    <record id="slot_stprod_box_on_hand" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_stock_products"/>
        <field name="key">box_on_hand</field>
        <field name="name">On Hand</field>
        <field name="section">button_box</field>
        <field name="sequence">10</field>
        <field name="label">On Hand</field>
        <field name="icon">fa-cubes</field>
        <field name="show_if_zero" eval="True"/>
        <field name="amount_field">qty_available</field>
        <field name="action_method">action_open_quants</field>
        <field name="module_depends">stock</field>
    </record>
    <record id="slot_stprod_box_reserved" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_stock_products"/>
        <field name="key">box_reserved</field>
        <field name="name">Reserved</field>
        <field name="section">button_box</field>
        <field name="sequence">20</field>
        <field name="label">Reserved</field>
        <field name="icon">fa-lock</field>
        <field name="show_if_zero" eval="True"/>
        <field name="style">warning</field>
        <field name="style_mode">when_positive</field>
        <field name="is_attention_signal" eval="True"/>
        <field name="value_mode">amount</field>
        <field name="compute_model">stock.quant</field>
        <field name="relate_field">product_id</field>
        <field name="compute_domain">[('location_id.usage', '=', 'internal'), ('reserved_quantity', '&gt;', 0)]</field>
        <field name="compute_aggregator">__count</field>
        <field name="amount_aggregator">reserved_quantity:sum</field>
        <field name="action_xmlid">stock.action_view_inventory_tree</field>
        <field name="action_domain">[('product_id', '=', '{{id}}'), ('location_id.usage', '=', 'internal'), ('reserved_quantity', '&gt;', 0)]</field>
        <field name="module_depends">stock</field>
    </record>

    <!-- Bottom shortcuts: Transfers (not Inventory — that is On Hand) -->
    <record id="slot_stprod_bottom_transfers" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_stock_products"/>
        <field name="key">bottom_transfers</field>
        <field name="name">Transfers</field>
        <field name="section">bottom</field>
        <field name="sequence">10</field>
        <field name="label">Transfers</field>
        <field name="icon">fa-truck</field>
        <field name="show_if_zero" eval="True"/>
        <field name="compute_model">stock.picking</field>
        <field name="compute_domain">[('move_ids.product_id', '=', {{id}}), ('state', '!=', 'cancel')]</field>
        <field name="action_xmlid">stock.action_picking_tree_all</field>
        <field name="action_domain">[('move_ids.product_id', '=', '{{id}}')]</field>
        <field name="module_depends">stock</field>
    </record>
    <record id="slot_stprod_bottom_moves" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_stock_products"/>
        <field name="key">bottom_moves</field>
        <field name="name">Moves</field>
        <field name="section">bottom</field>
        <field name="sequence">20</field>
        <field name="label">Moves</field>
        <field name="icon">fa-arrows</field>
        <field name="show_if_zero" eval="True"/>
        <field name="compute_model">stock.move</field>
        <field name="relate_field">product_id</field>
        <field name="compute_domain">[('state', '!=', 'cancel')]</field>
        <field name="action_xmlid">stock.stock_move_action</field>
        <field name="action_domain">[('product_id', '=', '{{id}}')]</field>
        <field name="module_depends">stock</field>
    </record>

    <!-- Manage · Views -->
    <record id="slot_stprod_menu_quants" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_stock_products"/>
        <field name="key">view_quants</field>
        <field name="name">View Inventory</field>
        <field name="section">menu_views</field>
        <field name="sequence">10</field>
        <field name="label">Inventory</field>
        <field name="show_if_zero" eval="True"/>
        <field name="action_xmlid">stock.action_view_inventory_tree</field>
        <field name="action_domain">[('product_id', '=', '{{id}}')]</field>
        <field name="module_depends">stock</field>
    </record>
    <record id="slot_stprod_menu_transfers" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_stock_products"/>
        <field name="key">view_transfers</field>
        <field name="name">View Transfers</field>
        <field name="section">menu_views</field>
        <field name="sequence">20</field>
        <field name="label">Transfers</field>
        <field name="show_if_zero" eval="True"/>
        <field name="action_xmlid">stock.action_picking_tree_all</field>
        <field name="action_domain">[('move_ids.product_id', '=', '{{id}}')]</field>
        <field name="module_depends">stock</field>
    </record>
    <record id="slot_stprod_menu_moves" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_stock_products"/>
        <field name="key">view_moves</field>
        <field name="name">View Moves</field>
        <field name="section">menu_views</field>
        <field name="sequence">30</field>
        <field name="label">Moves</field>
        <field name="show_if_zero" eval="True"/>
        <field name="action_xmlid">stock.stock_move_action</field>
        <field name="action_domain">[('product_id', '=', '{{id}}')]</field>
        <field name="module_depends">stock</field>
    </record>

    <!-- Manage · Reports -->
    <record id="slot_stprod_menu_report_moves" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_stock_products"/>
        <field name="key">report_moves</field>
        <field name="name">Report Moves</field>
        <field name="section">menu_reports</field>
        <field name="sequence">10</field>
        <field name="label">Moves Analysis</field>
        <field name="show_if_zero" eval="True"/>
        <field name="action_xmlid">stock.stock_move_action</field>
        <field name="action_domain">[('product_id', '=', '{{id}}')]</field>
        <field name="module_depends">stock</field>
    </record>
</odoo>
