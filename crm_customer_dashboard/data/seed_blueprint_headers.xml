<?xml version="1.0" encoding="utf-8"?>
<!--
  CRM Customers header lines.
-->
<odoo noupdate="1">
    <record id="blueprint_crm_customers" model="dashboard.blueprint">
        <field name="header_title_field">display_name</field>
        <field name="header_image_field">image_128</field>
        <field name="header_image_style">avatar</field>
    </record>

<record id="header_crm_job" model="dashboard.blueprint.header.item">
        <field name="blueprint_id" ref="blueprint_crm_customers"/>
        <field name="sequence">10</field>
        <field name="kind">subtitle</field>
        <field name="field_names">function,parent_id</field>
        <field name="separator" eval="' at '"/>
    </record>

<record id="header_crm_location" model="dashboard.blueprint.header.item">
        <field name="blueprint_id" ref="blueprint_crm_customers"/>
        <field name="sequence">20</field>
        <field name="kind">left</field>
        <field name="icon">fa-map-marker</field>
        <field name="field_names">city,country_id</field>
        <field name="separator" eval="', '"/>
    </record>

<record id="header_crm_email" model="dashboard.blueprint.header.item">
        <field name="blueprint_id" ref="blueprint_crm_customers"/>
        <field name="sequence">30</field>
        <field name="kind">left</field>
        <field name="icon">fa-envelope</field>
        <field name="field_names">email</field>
    </record>

<record id="header_crm_tags" model="dashboard.blueprint.header.item">
        <field name="blueprint_id" ref="blueprint_crm_customers"/>
        <field name="sequence">40</field>
        <field name="kind">right</field>
        <field name="field_names">category_id</field>
    </record>
</odoo>
