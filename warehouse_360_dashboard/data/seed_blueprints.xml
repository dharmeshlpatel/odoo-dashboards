<?xml version="1.0" encoding="utf-8"?>
<!-- Warehouse 360: location is a scope, not a standalone app (catalog Q5). -->
<odoo noupdate="1">
    <record id="blueprint_warehouse_360" model="dashboard.blueprint">
        <field name="name">Warehouse 360</field>
        <field name="key">warehouse_360</field>
        <field name="host_model_id" ref="stock.model_stock_warehouse"/>
        <field name="module_depends">stock</field>
        <field name="menu_name">Warehouse 360</field>
        <field name="menu_parent_xmlid">stock.menu_warehouse_report</field>
        <field name="menu_sequence">5</field>
        <field name="primary_button_label">Transfers</field>
        <field name="primary_action_xmlid">stock.action_picking_tree_all</field>
        <field name="graph_model">stock.picking</field>
        <field name="graph_data_field"></field>
        <field name="graph_measure">__count</field>
        <field name="graph_groupby">scheduled_date:month</field>
        <field name="graph_domain">[]</field>
        <field name="graph_caption">Transfers</field>
        <field name="lens_my_enabled" eval="False"/>
        <field name="lens_kpis_enabled" eval="True"/>
        <field name="lens_kpis_default" eval="True"/>
        <field name="lens_kpis_label">With KPIs</field>
        <field name="lens_attention_enabled" eval="True"/>
        <field name="lens_attention_default" eval="True"/>
        <field name="lens_attention_label">Needs attention</field>
        <field name="state">draft</field>
        <field name="sequence">5</field>
    </record>

    <!-- Location scopes (catalog Q5) — filter pickings / moves by location usage -->
    <record id="scope_wh360_internal" model="dashboard.blueprint.scope">
        <field name="blueprint_id" ref="blueprint_warehouse_360"/>
        <field name="sequence">10</field>
        <field name="name">Internal locations</field>
        <field name="description">Focus on stock inside warehouse internal locations.</field>
        <field name="mode">include</field>
        <field name="domain">[('location_id.usage', '=', 'internal')]</field>
        <field name="default_on" eval="True"/>
    </record>
    <record id="scope_wh360_incoming" model="dashboard.blueprint.scope">
        <field name="blueprint_id" ref="blueprint_warehouse_360"/>
        <field name="sequence">20</field>
        <field name="name">Incoming</field>
        <field name="mode">include</field>
        <field name="domain">[('picking_type_id.code', '=', 'incoming')]</field>
        <field name="default_on" eval="True"/>
    </record>
    <record id="scope_wh360_outgoing" model="dashboard.blueprint.scope">
        <field name="blueprint_id" ref="blueprint_warehouse_360"/>
        <field name="sequence">30</field>
        <field name="name">Outgoing</field>
        <field name="mode">include</field>
        <field name="domain">[('picking_type_id.code', '=', 'outgoing')]</field>
        <field name="default_on" eval="True"/>
    </record>
    <record id="scope_wh360_internal_xfer" model="dashboard.blueprint.scope">
        <field name="blueprint_id" ref="blueprint_warehouse_360"/>
        <field name="sequence">40</field>
        <field name="name">Internal transfers</field>
        <field name="mode">include</field>
        <field name="domain">[('picking_type_id.code', '=', 'internal')]</field>
        <field name="default_on" eval="False"/>
    </record>

    <record id="slot_wh360_late" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_warehouse_360"/>
        <field name="key">late_transfers</field>
        <field name="name">Late Transfers</field>
        <field name="section">kpi</field>
        <field name="sequence">15</field>
        <field name="label">Late Transfer</field>
        <field name="label_plural">Late Transfers</field>
        <field name="style">danger</field>
        <field name="style_mode">when_positive</field>
        <field name="is_attention_signal" eval="True"/>
        <field name="compute_model">stock.picking</field>
        <field name="compute_domain">[('picking_type_id.warehouse_id', '=', {{id}}), ('state', 'not in', ('done', 'cancel'))]</field>
        <field name="compute_aggregator">__count</field>
        <field name="action_xmlid">stock.action_picking_tree_all</field>
        <field name="action_domain">[('picking_type_id.warehouse_id', '=', '{{id}}'), ('state', 'not in', ('done', 'cancel'))]</field>
        <field name="module_depends">stock</field>
    </record>
</odoo>
