<?xml version="1.0" encoding="utf-8"?>
<!-- Default Chart model picker option(s) (mirrors blueprint graph / primary). -->
<odoo noupdate="1">
    <record id="graph_variant_sales_campaigns_sale_report" model="dashboard.blueprint.graph.variant">
        <field name="blueprint_id" ref="blueprint_sales_campaigns"/>
        <field name="sequence">10</field>
        <field name="is_default" eval="True"/>
        <field name="graph_model">sale.report</field>
        <field name="graph_data_field">campaign_id</field>
        <field name="primary_button_label">Sales Analysis</field>
        <field name="primary_action_xmlid">sale.action_order_report_all</field>
        <field name="primary_action_context">{}</field>
    </record>

    <record id="graph_variant_sales_mediums_sale_report" model="dashboard.blueprint.graph.variant">
        <field name="blueprint_id" ref="blueprint_sales_mediums"/>
        <field name="sequence">10</field>
        <field name="is_default" eval="True"/>
        <field name="graph_model">sale.report</field>
        <field name="graph_data_field">medium_id</field>
        <field name="primary_button_label">Sales Analysis</field>
        <field name="primary_action_xmlid">sale.action_order_report_all</field>
        <field name="primary_action_context">{}</field>
    </record>

    <record id="graph_variant_sales_sources_sale_report" model="dashboard.blueprint.graph.variant">
        <field name="blueprint_id" ref="blueprint_sales_sources"/>
        <field name="sequence">10</field>
        <field name="is_default" eval="True"/>
        <field name="graph_model">sale.report</field>
        <field name="graph_data_field">source_id</field>
        <field name="primary_button_label">Sales Analysis</field>
        <field name="primary_action_xmlid">sale.action_order_report_all</field>
        <field name="primary_action_context">{}</field>
    </record>

</odoo>
