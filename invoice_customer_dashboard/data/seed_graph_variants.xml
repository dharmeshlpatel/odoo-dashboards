<?xml version="1.0" encoding="utf-8"?>
<!-- Default Chart model picker option(s) (mirrors blueprint graph / primary). -->
<odoo noupdate="1">
    <record id="graph_variant_invoice_customers_account_invoice_report" model="dashboard.blueprint.graph.variant">
        <field name="blueprint_id" ref="blueprint_invoice_customers"/>
        <field name="sequence">10</field>
        <field name="is_default" eval="True"/>
        <field name="graph_model">account.invoice.report</field>
        <field name="graph_data_field">partner_id</field>
