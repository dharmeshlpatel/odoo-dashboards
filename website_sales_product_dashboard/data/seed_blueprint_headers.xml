<?xml version="1.0" encoding="utf-8"?>
<!-- Product card headers (product.product). -->
<odoo noupdate="1">
    <record id="blueprint_website_products" model="dashboard.blueprint">
        <field name="header_title_field">display_name</field>
        <field name="header_image_field">image_128</field>
        <field name="header_image_style">avatar</field>
    </record>
    <record id="header_website_prod_header_code" model="dashboard.blueprint.header.item">
        <field name="blueprint_id" ref="blueprint_website_products"/>
        <field name="sequence">10</field>
        <field name="kind">subtitle</field>
        <field name="alignment">left</field>
        <field name="field_names">default_code</field>
    </record>
    <record id="header_website_prod_header_barcode" model="dashboard.blueprint.header.item">
        <field name="blueprint_id" ref="blueprint_website_products"/>
        <field name="sequence">20</field>
        <field name="kind">inline</field>
        <field name="alignment">left</field>
        <field name="icon">fa-barcode</field>
        <field name="field_names">barcode</field>
    </record>
</odoo>
