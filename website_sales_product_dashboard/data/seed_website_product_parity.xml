<?xml version="1.0" encoding="utf-8"?>
<!-- Website Sales Products fill. -->
<odoo noupdate="1">
    <record id="blueprint_website_products" model="dashboard.blueprint">
        <field name="primary_button_label">Online Sales Analysis</field>
        <field name="primary_action_xmlid">sale.action_order_report_all</field>
        <field name="primary_action_domain">[('website_id', '!=', False)]</field>
        <field name="graph_model">sale.report</field>
        <field name="graph_data_field">product_id</field>
        <field name="graph_measure">price_subtotal:sum</field>
        <field name="graph_groupby">date:month</field>
        <field name="graph_domain">[('website_id', '!=', False)]</field>
        <field name="graph_caption">Online Sales</field>
    </record>

    <record id="slot_website_prod_kpi_quotations" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_website_products"/>
        <field name="key">website_prod_quotations</field>
        <field name="name">Quotations</field>
        <field name="section">kpi</field>
        <field name="sequence">20</field>
        <field name="label">Quotation line</field>
        <field name="label_plural">Quotation lines</field>
        <field name="compute_model">sale.order.line</field>
        <field name="relate_field">product_id</field>
        <field name="compute_domain">[('order_id.website_id', '!=', False), ('state', 'in', ('draft', 'sent'))]</field>
        <field name="compute_aggregator">__count</field>
        <field name="action_xmlid">sale.action_quotations_with_onboarding</field>
        <field name="action_domain">[('order_line.product_id', '=', '{{id}}'), ('website_id', '!=', False), ('state', 'in', ('draft', 'sent'))]</field>
        <field name="module_depends">website_sale,product</field>
    </record>
    <record id="slot_website_prod_kpi_to_invoice" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_website_products"/>
        <field name="key">website_prod_to_invoice</field>
        <field name="name">To Invoice</field>
        <field name="section">kpi</field>
        <field name="sequence">30</field>
        <field name="label">Line to Invoice</field>
        <field name="label_plural">Lines to Invoice</field>
        <field name="compute_model">sale.order.line</field>
        <field name="relate_field">product_id</field>
        <field name="compute_domain">[('order_id.website_id', '!=', False), ('invoice_status', '=', 'to invoice')]</field>
        <field name="compute_aggregator">__count</field>
        <field name="action_xmlid">sale.action_orders_to_invoice</field>
        <field name="action_domain">[('order_line.product_id', '=', '{{id}}'), ('website_id', '!=', False), ('invoice_status', '=', 'to invoice')]</field>
        <field name="module_depends">website_sale,product</field>
    </record>

    <record id="slot_website_prod_box_on_hand" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_website_products"/>
        <field name="key">box_on_hand</field>
        <field name="name">On Hand</field>
        <field name="section">button_box</field>
        <field name="sequence">10</field>
        <field name="label">On Hand</field>
        <field name="icon">fa-cubes</field>
        <field name="show_if_zero" eval="True"/>
        <field name="amount_field">qty_available</field>
        <field name="action_method">action_open_quants</field>
        <field name="module_depends">website_sale,stock</field>
    </record>

    <record id="slot_website_prod_bottom_orders" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_website_products"/>
        <field name="key">bottom_orders</field>
        <field name="name">Orders Button</field>
        <field name="section">bottom</field>
        <field name="sequence">20</field>
        <field name="label">Orders</field>
        <field name="icon">fa-shopping-cart</field>
        <field name="show_if_zero" eval="True"/>
        <field name="compute_model">sale.order.line</field>
        <field name="relate_field">product_id</field>
        <field name="compute_domain">[('order_id.website_id', '!=', False), ('state', 'in', ('sale', 'done'))]</field>
        <field name="action_xmlid">sale.action_orders</field>
        <field name="action_domain">[('order_line.product_id', '=', '{{id}}'), ('website_id', '!=', False)]</field>
        <field name="module_depends">website_sale,product</field>
    </record>

    <record id="slot_website_prod_menu_orders" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_website_products"/>
        <field name="key">view_orders</field>
        <field name="name">View Orders</field>
        <field name="section">menu_views</field>
        <field name="sequence">20</field>
        <field name="label">Orders</field>
        <field name="show_if_zero" eval="True"/>
        <field name="action_xmlid">sale.action_orders</field>
        <field name="action_domain">[('order_line.product_id', '=', '{{id}}'), ('website_id', '!=', False)]</field>
        <field name="module_depends">website_sale,product</field>
    </record>
    <record id="slot_website_prod_menu_report" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_website_products"/>
        <field name="key">report_online</field>
        <field name="name">Report Online Sales</field>
        <field name="section">menu_reports</field>
        <field name="sequence">10</field>
        <field name="label">Online Sales</field>
        <field name="show_if_zero" eval="True"/>
        <field name="action_xmlid">sale.action_order_report_all</field>
        <field name="action_domain">[('product_id', '=', '{{id}}'), ('website_id', '!=', False)]</field>
        <field name="module_depends">website_sale,product</field>
    </record>
</odoo>
