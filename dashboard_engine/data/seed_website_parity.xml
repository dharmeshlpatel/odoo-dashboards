<?xml version="1.0" encoding="utf-8"?>
<!-- Website sales customer dashboard (v1 website_sales_customer_dashboard_enterprise). -->
<odoo noupdate="1">
    <record id="blueprint_website_customers" model="dashboard.blueprint">
        <field name="name">Website Customers</field>
        <field name="key">website_customers</field>
        <field name="host_model_id" ref="base.model_res_partner"/>
        <field name="module_depends">website_sale</field>
        <field name="menu_name">Customers Dashboard</field>
        <field name="menu_parent_xmlid">sale.sale_menu_root</field>
        <field name="menu_sequence">40</field>
        <field name="primary_button_label">Online Orders</field>
        <field name="primary_action_xmlid">sale.action_orders</field>
        <field name="graph_model">sale.order</field>
        <field name="graph_data_field">partner_id</field>
        <field name="graph_measure">amount_total:sum</field>
        <field name="graph_groupby">date_order:month</field>
        <field name="graph_domain">[('website_id', '!=', False)]</field>
        <field name="graph_caption">Online Orders</field>
        <field name="state">published</field>
        <field name="sequence">35</field>
    </record>

    <record id="scope_website_orders" model="dashboard.blueprint.scope">
        <field name="blueprint_id" ref="blueprint_website_customers"/>
        <field name="sequence">10</field>
        <field name="name">Online Orders</field>
        <field name="mode">include</field>
        <field name="domain">[('website_id', '!=', False), ('state', 'in', ('sale', 'done'))]</field>
        <field name="default_on" eval="True"/>
    </record>
    <record id="scope_website_abandoned" model="dashboard.blueprint.scope">
        <field name="blueprint_id" ref="blueprint_website_customers"/>
        <field name="sequence">20</field>
        <field name="name">Abandoned Carts</field>
        <field name="mode">include</field>
        <field name="domain">[('website_id', '!=', False), ('state', '=', 'draft'), ('is_abandoned_cart', '=', True)]</field>
        <field name="default_on" eval="False"/>
    </record>

    <record id="slot_website_unpaid" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_website_customers"/>
        <field name="key">unpaid_online</field>
        <field name="name">Unpaid Online</field>
        <field name="section">kpi</field>
        <field name="sequence">10</field>
        <field name="label">Unpaid Order</field>
        <field name="label_plural">Unpaid Orders</field>
        <field name="compute_model">sale.order</field>
        <field name="relate_field">partner_id</field>
        <field name="compute_domain">[('website_id', '!=', False), ('state', '=', 'sent')]</field>
        <field name="compute_aggregator">__count</field>
        <field name="amount_aggregator">amount_total:sum</field>
        <field name="action_xmlid">sale.action_quotations_with_onboarding</field>
        <field name="action_domain">[('website_id', '!=', False), ('state', '=', 'sent'), ('partner_id', '=', '{{id}}')]</field>
        <field name="module_depends">website_sale</field>
    </record>

    <record id="slot_website_abandoned" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_website_customers"/>
        <field name="key">abandoned_carts</field>
        <field name="name">Abandoned Carts</field>
        <field name="section">kpi</field>
        <field name="sequence">20</field>
        <field name="label">Abandoned Cart</field>
        <field name="label_plural">Abandoned Carts</field>
        <field name="style">danger</field>
        <field name="compute_model">sale.order</field>
        <field name="relate_field">partner_id</field>
        <field name="compute_domain">[('website_id', '!=', False), ('state', '=', 'draft'), ('is_abandoned_cart', '=', True)]</field>
        <field name="compute_aggregator">__count</field>
        <field name="action_xmlid">sale.action_quotations_with_onboarding</field>
        <field name="action_domain">[('website_id', '!=', False), ('state', '=', 'draft'), ('is_abandoned_cart', '=', True), ('partner_id', '=', '{{id}}')]</field>
        <field name="module_depends">website_sale</field>
    </record>

    <record id="slot_website_bottom_orders" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_website_customers"/>
        <field name="key">bottom_online</field>
        <field name="name">Online Orders Button</field>
        <field name="section">bottom</field>
        <field name="sequence">10</field>
        <field name="label">Online Orders</field>
        <field name="icon">fa-globe</field>
        <field name="show_if_zero" eval="True"/>
        <field name="compute_model">sale.order</field>
        <field name="relate_field">partner_id</field>
        <field name="compute_domain">[('website_id', '!=', False)]</field>
        <field name="action_xmlid">sale.action_orders</field>
        <field name="action_domain">[('website_id', '!=', False), ('partner_id', '=', '{{id}}')]</field>
        <field name="module_depends">website_sale</field>
    </record>

    <record id="slot_website_menu_orders" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_website_customers"/>
        <field name="key">view_online_orders</field>
        <field name="name">View Online Orders</field>
        <field name="section">menu_views</field>
        <field name="sequence">10</field>
        <field name="label">Online Orders</field>
        <field name="show_if_zero" eval="True"/>
        <field name="action_xmlid">sale.action_orders</field>
        <field name="action_domain">[('website_id', '!=', False), ('partner_id', '=', '{{id}}')]</field>
        <field name="module_depends">website_sale</field>
    </record>
</odoo>
