<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
        ===========================================================================
        Dashboard Graph Period Configuration
        ===========================================================================
        This file defines reusable time-period records used by dashboard graphs.
        These periods are referenced while generating graph data for:
            - Monthly comparisons
            - Quarterly analysis
            - Yearly trends

        Models used:
            - period.month.quarter : For month- and quarter-based periods
            - period.year          : For year-based periods

        Note:
        - `noupdate="1"` ensures that these records are not modified
          during module upgrades once created.
        ============================================================================
        -->

        <!-- ========================= -->
        <!-- Periods : Month-based -->
        <!-- ========================= -->

        <!-- Current month -->
        <record id="period_month_quarter_this_month" model="period.month.quarter">
            <field name="name">month</field>
        </record>
        <!-- Previous month (last month) -->
        <record id="period_month_quarter_last_month" model="period.month.quarter">
            <field name="name">month-1</field>
        </record>
        <!-- Month before last (two months ago) -->
        <record id="period_month_quarter_antepenultimate_month" model="period.month.quarter">
            <field name="name">month-2</field>
        </record>

        <!-- ========================= -->
        <!-- Periods : Quarter-based -->
        <!-- ========================= -->

        <!-- Fourth quarter (Q4) -->
        <record id="period_month_quarter_fourth_quarter" model="period.month.quarter">
            <field name="name">fourth_quarter</field>
        </record>
        <!-- Third quarter (Q3) -->
        <record id="period_month_quarter_third_quarter" model="period.month.quarter">
            <field name="name">third_quarter</field>
        </record>
        <!-- Second quarter (Q2) -->
        <record id="period_month_quarter_second_quarter" model="period.month.quarter">
            <field name="name">second_quarter</field>
        </record>
        <!-- First quarter (Q1) -->
        <record id="period_month_quarter_first_quarter" model="period.month.quarter">
            <field name="name">first_quarter</field>
        </record>

        <!-- ========================= -->
        <!-- Periods : Year-based -->
        <!-- ========================= -->

        <!-- Current year -->
        <record id="period_year_this_year" model="period.year">
            <field name="name">year</field>
        </record>
        <!-- Previous year (last year) -->
        <record id="period_year_last_year" model="period.year">
            <field name="name">year-1</field>
        </record>
        <!-- Year before last (two years ago) -->
        <record id="period_year_antepenultimate_year" model="period.year">
            <field name="name">year-2</field>
        </record>

    </data>
</odoo>