<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Soft CRM customer blueprint (activates when crm is installed) -->
    <record id="blueprint_crm_customers" model="dashboard.blueprint">
        <field name="name">CRM Customers</field>
        <field name="key">crm_customers</field>
        <field name="host_model_id" ref="base.model_res_partner"/>
        <field name="module_depends">crm</field>
        <field name="menu_name">Customers Dashboard</field>
        <field name="menu_parent_xmlid">crm.crm_menu_root</field>
        <field name="menu_sequence">5</field>
        <field name="primary_button_label">Pipeline Analysis</field>
        <field name="primary_action_xmlid">crm.crm_lead_action_pipeline</field>
        <field name="graph_model">crm.lead</field>
        <field name="graph_data_field">partner_id</field>
        <field name="graph_measure">__count</field>
        <field name="graph_groupby">stage_id</field>
        <field name="graph_domain">[]</field>
        <field name="graph_caption">Open pipeline</field>
        <field name="state">published</field>
        <field name="sequence">10</field>
    </record>

    <!--
      Tick boxes offered by the settings popup (labels/help are data-driven).
      Sequence matches v1 gear order: restrict scope first (own row), then
      include scopes which the widget packs two-across.
    -->
    <record id="scope_crm_mine" model="dashboard.blueprint.scope">
        <field name="blueprint_id" ref="blueprint_crm_customers"/>
        <field name="sequence">10</field>
        <field name="name">My Pipeline</field>
        <field name="description">Show only opportunities that are assigned to you.</field>
        <field name="mode">restrict</field>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="default_on" eval="False"/>
    </record>
    <record id="scope_crm_pipeline" model="dashboard.blueprint.scope">
        <field name="blueprint_id" ref="blueprint_crm_customers"/>
        <field name="sequence">20</field>
        <field name="name">Pipeline</field>
        <field name="description">Include opportunity-related records in the dashboard analysis.</field>
        <field name="mode">include</field>
        <field name="domain">[('type', '=', 'opportunity')]</field>
        <field name="default_on" eval="True"/>
    </record>
    <record id="scope_crm_leads" model="dashboard.blueprint.scope">
        <field name="blueprint_id" ref="blueprint_crm_customers"/>
        <field name="sequence">30</field>
        <field name="name">Leads</field>
        <field name="description">Include lead-related records in the dashboard analysis.</field>
        <field name="mode">include</field>
        <field name="domain">[('type', '=', 'lead')]</field>
        <field name="default_on" eval="False"/>
    </record>
    <!-- Module-aware label variants for the restrict scope (most specific wins). -->
    <record id="scope_crm_mine_label_sale" model="dashboard.blueprint.scope.label">
        <field name="scope_id" ref="scope_crm_mine"/>
        <field name="sequence">10</field>
        <field name="module_depends">sale</field>
        <field name="name">My Pipeline and Sales Orders</field>
        <field name="description">Check this box to show opportunities and sales orders you are responsible for.</field>
    </record>
    <record id="scope_crm_mine_label_website" model="dashboard.blueprint.scope.label">
        <field name="scope_id" ref="scope_crm_mine"/>
        <field name="sequence">20</field>
        <field name="module_depends">sale,website_sale</field>
        <field name="name">My Pipeline, Sales and Website Orders</field>
        <field name="description">Check this box to show opportunities, sales and website orders you are responsible for.</field>
    </record>

    <!--
      Second pass on the same record: these fields reference the scope
      above, which must exist first. Also: opportunities linked to a
      company's child contacts count on the company's own actions, not
      just leads/opportunities set directly on this exact partner id.
    -->
    <record id="blueprint_crm_customers" model="dashboard.blueprint">
        <field name="include_child_records" eval="True"/>
        <field name="primary_label_alt_scope_id" ref="scope_crm_pipeline"/>
        <field name="primary_label_alt">Leads Analysis</field>
    </record>

    <record id="slot_crm_open_opportunities" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_crm_customers"/>
        <field name="key">open_opportunities</field>
        <field name="name">Open Opportunities</field>
        <field name="section">kpi</field>
        <field name="sequence">20</field>
        <field name="label">Open Opportunity</field>
        <field name="label_plural">Open Opportunities</field>
        <field name="compute_model">crm.lead</field>
        <field name="relate_field">partner_id</field>
        <field name="compute_domain">[('type', '=', 'opportunity'), ('probability', '&lt;', 100), ('active', '=', True)]</field>
        <field name="compute_aggregator">__count</field>
        <field name="amount_aggregator">expected_revenue:sum</field>
        <field name="action_xmlid">crm.crm_lead_action_pipeline</field>
        <field name="action_domain">[('type', '=', 'opportunity'), ('probability', '&lt;', 100), ('active', '=', True), ('partner_id', 'child_of', '{{id}}')]</field>
        <field name="action_context">{"default_type": "opportunity"}</field>
    </record>

    <record id="slot_crm_overdue_opportunities" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_crm_customers"/>
        <field name="key">overdue_opportunities</field>
        <field name="name">Overdue Opportunities</field>
        <field name="section">kpi</field>
        <field name="sequence">30</field>
        <field name="label">Overdue Opportunity</field>
        <field name="label_plural">Overdue Opportunities</field>
        <field name="style">danger</field>
        <field name="compute_model">crm.lead</field>
        <field name="relate_field">partner_id</field>
        <!-- Domain lives on the shared condition (relative deadline). -->
        <field name="compute_domain">[]</field>
        <field name="condition_ids" eval="[(4, ref('condition_crm_overdue_opportunity'))]"/>
        <field name="compute_aggregator">__count</field>
        <field name="amount_aggregator">expected_revenue:sum</field>
        <field name="action_xmlid">crm.crm_lead_action_pipeline</field>
        <field name="action_domain">[('partner_id', 'child_of', '{{id}}')]</field>
        <field name="action_context">{"default_type": "opportunity"}</field>
    </record>

    <!-- No KPI badge on this menu item, so child_of is safe (see seed_crm_parity.xml). -->
    <record id="slot_crm_menu_opportunities" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_crm_customers"/>
        <field name="key">view_opportunities</field>
        <field name="name">View Opportunities</field>
        <field name="section">menu_views</field>
        <field name="sequence">20</field>
        <field name="label">Opportunities</field>
        <field name="show_if_zero" eval="True"/>
        <field name="action_xmlid">crm.crm_lead_action_pipeline</field>
        <field name="action_domain">[('partner_id', 'child_of', '{{id}}')]</field>
    </record>

    <!--
      Both the badge (compute_domain, folded by include_child_records in Python)
      and this click-through use child_of, so the number always matches
      what opens.
    -->
    <record id="slot_crm_bottom_opportunities" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_crm_customers"/>
        <field name="key">bottom_opportunities</field>
        <field name="name">Opportunities Button</field>
        <field name="section">bottom</field>
        <field name="sequence">10</field>
        <field name="label">Opportunities</field>
        <field name="icon">fa-star</field>
        <field name="show_if_zero" eval="True"/>
        <field name="groups_xmlids">sales_team.group_sale_salesman</field>
        <field name="compute_model">crm.lead</field>
        <field name="relate_field">partner_id</field>
        <field name="compute_domain">[('type', '=', 'opportunity')]</field>
        <field name="action_xmlid">crm.crm_lead_action_pipeline</field>
        <field name="action_domain">[('partner_id', 'child_of', '{{id}}'), ('type', '=', 'opportunity')]</field>
        <field name="action_context">{"search_default_partner_id": [{{id}}], "default_partner_id": {{id}}, "default_type": "opportunity"}</field>
        <field name="module_depends">crm,sales_team</field>
    </record>

    <!-- Soft Sales customer blueprint -->
    <record id="blueprint_sales_customers" model="dashboard.blueprint">
        <field name="name">Sales Customers</field>
        <field name="key">sales_customers</field>
        <field name="host_model_id" ref="base.model_res_partner"/>
        <field name="module_depends">sale</field>
        <field name="menu_name">Customers Dashboard</field>
        <field name="menu_parent_xmlid">sale.sale_menu_root</field>
        <field name="menu_sequence">5</field>
        <field name="primary_button_label">Sales Analysis</field>
        <field name="primary_action_xmlid">sale.action_order_report_all</field>
        <field name="graph_model">sale.report</field>
        <field name="graph_data_field">partner_id</field>
        <field name="graph_measure">price_subtotal:sum</field>
        <field name="graph_groupby">date:month</field>
        <field name="graph_domain">[]</field>
        <field name="graph_caption">Sales</field>
        <field name="state">published</field>
        <field name="sequence">20</field>
    </record>

    <record id="scope_sale_orders" model="dashboard.blueprint.scope">
        <field name="blueprint_id" ref="blueprint_sales_customers"/>
        <field name="sequence">10</field>
        <field name="name">Sales Orders</field>
        <field name="mode">include</field>
        <field name="domain">[('state', 'in', ['sale', 'done'])]</field>
        <field name="default_on" eval="True"/>
    </record>
    <record id="scope_sale_quotations" model="dashboard.blueprint.scope">
        <field name="blueprint_id" ref="blueprint_sales_customers"/>
        <field name="sequence">20</field>
        <field name="name">Quotations</field>
        <field name="mode">include</field>
        <field name="domain">[('state', 'in', ['draft', 'sent'])]</field>
        <field name="default_on" eval="False"/>
    </record>
    <record id="scope_sale_mine" model="dashboard.blueprint.scope">
        <field name="blueprint_id" ref="blueprint_sales_customers"/>
        <field name="sequence">30</field>
        <field name="name">Only mine</field>
        <field name="description">Show only sales orders you are responsible for.</field>
        <field name="mode">restrict</field>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="default_on" eval="False"/>
    </record>

    <record id="slot_sale_quotations" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_sales_customers"/>
        <field name="key">quotations</field>
        <field name="name">Quotations</field>
        <field name="section">kpi</field>
        <field name="sequence">10</field>
        <field name="label">Quotation</field>
        <field name="label_plural">Quotations</field>
        <field name="compute_model">sale.order</field>
        <field name="relate_field">partner_id</field>
        <field name="compute_domain">[('state', 'in', ('draft', 'sent'))]</field>
        <field name="compute_aggregator">__count</field>
        <field name="amount_aggregator">amount_total:sum</field>
        <field name="action_xmlid">sale.action_quotations_with_onboarding</field>
        <field name="action_domain">[('state', 'in', ('draft', 'sent')), ('partner_id', '=', '{{id}}')]</field>
        <field name="visible_if_context">{"in_pos_app": false}</field>
    </record>

    <record id="slot_sale_bottom_orders" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_sales_customers"/>
        <field name="key">bottom_sales</field>
        <field name="name">Sales Button</field>
        <field name="section">bottom</field>
        <field name="sequence">10</field>
        <field name="label">Sales</field>
        <field name="icon">fa-usd</field>
        <field name="show_if_zero" eval="True"/>
        <field name="groups_xmlids">sales_team.group_sale_salesman</field>
        <field name="compute_model">sale.order</field>
        <field name="relate_field">partner_id</field>
        <field name="compute_domain">[('state', '!=', 'cancel')]</field>
        <field name="action_xmlid">sale.act_res_partner_2_sale_order</field>
        <field name="module_depends">sale,sales_team</field>
    </record>

    <!-- Soft POS customer blueprint -->
    <record id="blueprint_pos_customers" model="dashboard.blueprint">
        <field name="name">POS Customers</field>
        <field name="key">pos_customers</field>
        <field name="host_model_id" ref="base.model_res_partner"/>
        <field name="module_depends">point_of_sale</field>
        <field name="menu_name">Customers Dashboard</field>
        <field name="menu_parent_xmlid">point_of_sale.menu_point_root</field>
        <field name="primary_button_label">POS Orders</field>
        <field name="primary_action_xmlid">point_of_sale.action_pos_pos_form</field>
        <field name="graph_model">pos.order</field>
        <field name="graph_data_field">partner_id</field>
        <field name="graph_measure">__count</field>
        <field name="graph_groupby">date_order:month</field>
        <field name="graph_caption">POS Orders</field>
        <field name="state">published</field>
        <field name="sequence">30</field>
    </record>

    <record id="slot_pos_orders_kpi" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_pos_customers"/>
        <field name="key">pos_orders</field>
        <field name="name">POS Orders</field>
        <field name="section">kpi</field>
        <field name="sequence">10</field>
        <field name="label">POS Order</field>
        <field name="label_plural">POS Orders</field>
        <field name="compute_model">pos.order</field>
        <field name="relate_field">partner_id</field>
        <field name="compute_domain">[('state', '!=', 'cancel')]</field>
        <field name="action_model">pos.order</field>
        <field name="action_domain">[('partner_id', '=', '{{id}}')]</field>
    </record>

    <record id="slot_pos_bottom" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_pos_customers"/>
        <field name="key">bottom_pos</field>
        <field name="name">POS Orders Button</field>
        <field name="section">bottom</field>
        <field name="sequence">10</field>
        <field name="label">POS Orders</field>
        <field name="icon">fa-shopping-bag</field>
        <field name="show_if_zero" eval="True"/>
        <field name="compute_model">pos.order</field>
        <field name="relate_field">partner_id</field>
        <field name="compute_domain">[('state', '!=', 'cancel')]</field>
        <field name="action_model">pos.order</field>
        <field name="action_domain">[('partner_id', '=', '{{id}}')]</field>
        <field name="module_depends">point_of_sale</field>
    </record>
</odoo>
