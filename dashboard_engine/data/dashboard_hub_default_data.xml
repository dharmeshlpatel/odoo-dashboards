<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Default shared hub for grouping (no menu under Dashboard Engine).
      Admins can set Parent Menu on Hub Menus if they want a hub entry.
    -->
    <record id="dashboard_hub_default" model="dashboard.blueprint.hub">
        <field name="name">Dashboards</field>
        <field name="menu_parent_id" eval="False"/>
        <field name="menu_sequence">1</field>
    </record>
</odoo>
