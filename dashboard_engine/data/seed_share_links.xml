<?xml version="1.0" encoding="utf-8"?>
<!--
  Bi-directional slot pools for all res.partner customer dashboards
  (V1 shared-kanban parity: CRM + Sales + Website + POS contribute once).
-->
<odoo noupdate="1">
    <record id="blueprint_crm_customers" model="dashboard.blueprint">
        <field name="share_link_ids" eval="[(6, 0, [
            ref('dashboard_engine.blueprint_sales_customers'),
            ref('dashboard_engine.blueprint_website_customers'),
            ref('dashboard_engine.blueprint_pos_customers'),
        ])]"/>
    </record>
    <record id="blueprint_sales_customers" model="dashboard.blueprint">
        <field name="share_link_ids" eval="[(6, 0, [
            ref('dashboard_engine.blueprint_crm_customers'),
            ref('dashboard_engine.blueprint_website_customers'),
            ref('dashboard_engine.blueprint_pos_customers'),
        ])]"/>
    </record>
    <record id="blueprint_website_customers" model="dashboard.blueprint">
        <field name="share_link_ids" eval="[(6, 0, [
            ref('dashboard_engine.blueprint_crm_customers'),
            ref('dashboard_engine.blueprint_sales_customers'),
            ref('dashboard_engine.blueprint_pos_customers'),
        ])]"/>
    </record>
    <record id="blueprint_pos_customers" model="dashboard.blueprint">
        <field name="share_link_ids" eval="[(6, 0, [
            ref('dashboard_engine.blueprint_crm_customers'),
            ref('dashboard_engine.blueprint_sales_customers'),
            ref('dashboard_engine.blueprint_website_customers'),
        ])]"/>
    </record>
</odoo>
