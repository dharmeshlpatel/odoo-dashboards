<?xml version="1.0" encoding="utf-8"?>
<!--
  Reusable filters referenced by seeded slots.

  Technical field names are stored so the seed loads even when CRM is not
  installed; pickers resolve once the app is present.
-->
<odoo noupdate="1">
    <record id="condition_crm_overdue_opportunity" model="dashboard.condition">
        <field name="name">Overdue open opportunity</field>
        <field name="model">crm.lead</field>
        <field name="match">all</field>
        <field name="module_depends">crm</field>
        <field name="note">Deadline before today, still open, type opportunity.</field>
    </record>
    <record id="rule_crm_overdue_type" model="dashboard.condition.rule">
        <field name="condition_id" ref="condition_crm_overdue_opportunity"/>
        <field name="sequence">10</field>
        <field name="field_name">type</field>
        <field name="operator">=</field>
        <field name="value_type">static</field>
        <field name="value_char">opportunity</field>
    </record>
    <record id="rule_crm_overdue_open" model="dashboard.condition.rule">
        <field name="condition_id" ref="condition_crm_overdue_opportunity"/>
        <field name="sequence">20</field>
        <field name="field_name">date_closed</field>
        <field name="operator">=</field>
        <field name="value_type">false</field>
    </record>
    <record id="rule_crm_overdue_deadline" model="dashboard.condition.rule">
        <field name="condition_id" ref="condition_crm_overdue_opportunity"/>
        <field name="sequence">30</field>
        <field name="field_name">date_deadline</field>
        <field name="operator">&lt;</field>
        <field name="value_type">relative_date</field>
        <field name="relative_when">today</field>
    </record>

    <!--
      Default CRM type for the viewer (lead vs opportunity by group).
      Not attached to slots: that would filter lists wrongly. New Lead /
      Opportunity slots set default_type in action_context instead.
      Kept for future action-default / create-context support.
    -->
    <record id="condition_crm_default_type" model="dashboard.condition">
        <field name="name">Default CRM type for viewer</field>
        <field name="model">crm.lead</field>
        <field name="match">all</field>
        <field name="module_depends">crm</field>
        <field name="note">Reserved for create defaults — do not AND onto View/Report domains.</field>
    </record>
    <record id="rule_crm_default_type" model="dashboard.condition.rule">
        <field name="condition_id" ref="condition_crm_default_type"/>
        <field name="sequence">10</field>
        <field name="field_name">type</field>
        <field name="operator">=</field>
        <field name="value_type">static</field>
        <field name="value_char">opportunity</field>
    </record>
    <record id="group_value_crm_use_lead" model="dashboard.condition.group.value">
        <field name="rule_id" ref="rule_crm_default_type"/>
        <field name="sequence">10</field>
        <field name="groups_xmlids">crm.group_use_lead</field>
        <field name="value_char">lead</field>
    </record>
</odoo>
