<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dashboard_engine.DashboardScopeCheckboxesField">
        <div class="o_dashboard_scope_checkboxes" aria-atomic="true">
            <t t-foreach="rows" t-as="row" t-key="row_index">
                <div class="row mt16 o_settings_container">
                    <t t-foreach="row" t-as="item" t-key="item.id">
                        <!-- Odoo settings standard: two columns (col-lg-6) for include
                             pairs (Pipeline | Leads). Restrict (My Data) stays full width. -->
                        <div t-attf-class="o_setting_box o_dashboard_scope_item {{item.mode === 'restrict' ? 'col-12' : 'col-12 col-lg-6'}}">
                            <div class="o_setting_left_pane">
                                <CheckBox
                                    value="isSelected(item)"
                                    disabled="props.readonly"
                                    onChange="(ev) => this.onChange(item.id, ev)"
                                />
                            </div>
                            <div class="o_setting_right_pane" t-on-click="() => this.onLabelClick(item)">
                                <label class="o_form_label">
                                    <t t-esc="item.display_label"/>
                                </label>
                                <div t-if="item.display_description"
                                     class="text-muted o_dashboard_scope_item_help">
                                    <t t-esc="item.display_description"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </t>
            <div t-if="state.scopeWarning"
                 class="alert alert-warning d-flex align-items-center gap-2 py-2 mt-2 mb-0">
                <i class="fa fa-exclamation-triangle"/>
                <span t-esc="state.scopeWarning"/>
            </div>
        </div>
    </t>
</templates>
