<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dashboard_engine.DashboardHubAction">
        <div class="o_dashboard_hub d-flex h-100">
            <aside class="o_dashboard_hub_sidebar border-end">
                <t t-foreach="state.tree" t-as="group" t-key="group.id">
                    <div t-if="group.name" class="o_dashboard_hub_group_label text-muted text-uppercase small px-3 pt-3 pb-1">
                        <t t-esc="group.name"/>
                    </div>
                    <t t-foreach="group.dashboards" t-as="dashboard" t-key="dashboard.id">
                        <button type="button"
                                class="o_dashboard_hub_item btn btn-link text-start w-100 rounded-0"
                                t-att-class="{ 'o_active': state.activeBlueprintId === dashboard.id }"
                                t-on-click="() => this.selectDashboard(dashboard.id)">
                            <t t-esc="dashboard.name"/>
                        </button>
                    </t>
                </t>
            </aside>
            <main class="o_dashboard_hub_main flex-grow-1 overflow-auto position-relative">
                <t t-if="state.viewProps">
                    <View t-props="state.viewProps" t-key="viewKey"/>
                </t>
                <div t-elif="state.loadingView" class="text-muted p-4">
                    Loading dashboard…
                </div>
                <div t-else="" class="o_view_nocontent" role="alert">
                    <div class="o_nocontent_help">
                        <t t-if="!state.tree.length">
                            <p class="o_view_nocontent_smiling_face">
                                <t t-esc="emptyTitle"/>
                            </p>
                            <p>
                                <t t-esc="emptyDescription"/>
                            </p>
                        </t>
                        <t t-else="">
                            <p class="o_view_nocontent_empty_folder">
                                <t t-esc="emptyTitle"/>
                            </p>
                        </t>
                    </div>
                </div>
            </main>
        </div>
    </t>
</templates>
