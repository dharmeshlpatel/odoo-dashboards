<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase 12 — import side of the export/import blueprint template feature.
  Export is a single button on the blueprint form (see
  dashboard_blueprint_views.xml); import is a small wizard since it needs a
  file picker and lands on the freshly created draft blueprint.
-->
<odoo>
    <record id="view_dashboard_blueprint_import_wizard_form" model="ir.ui.view">
        <field name="name">dashboard.blueprint.import.wizard.form</field>
        <field name="model">dashboard.blueprint.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Dashboard Blueprint Template">
                <p>
                    Pick a <code>.dashboard.json</code> file exported from another
                    blueprint (this or another database). It is always imported as
                    a new, unpublished blueprint — review and publish it yourself.
                </p>
                <group>
                    <field name="data_file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Import"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dashboard_blueprint_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Blueprint Template</field>
        <field name="res_model">dashboard.blueprint.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- List header (after import action exists — menus no longer expose this). -->
    <record id="view_dashboard_blueprint_tree_import" model="ir.ui.view">
        <field name="name">dashboard.blueprint.list.import</field>
        <field name="model">dashboard.blueprint</field>
        <field name="inherit_id" ref="view_dashboard_blueprint_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button name="%(action_dashboard_blueprint_import_wizard)d"
                            type="action"
                            string="Import Template"
                            display="always"
                            groups="dashboard_engine.group_dashboard_engine_manager"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
