<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dashboard_condition_list" model="ir.ui.view">
        <field name="name">dashboard.condition.list</field>
        <field name="model">dashboard.condition</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="model_id"/>
                <field name="module_ids" widget="many2many_tags" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_dashboard_condition_form" model="ir.ui.view">
        <field name="name">dashboard.condition.form</field>
        <field name="model">dashboard.condition</field>
        <field name="arch" type="xml">
            <form string="Condition" class="o_dashboard_condition_form">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Overdue open opportunities"/>
                        </h1>
                    </div>
                    <p class="text-muted small mb-3">
                        Reusable filter for KPIs. Use
                        <code>uid</code>, <code>company_id</code>, or
                        <code>active_id</code> (this card). Date before/after
                        supports presets such as Today or 7 days ago.
                    </p>
                    <group col="2">
                        <field name="model_id" options="{'no_create': True}"/>
                        <field name="module_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                        <field name="domain_model_name" invisible="1"/>
                        <field name="note" colspan="2"
                               placeholder="Optional note for builders…"/>
                    </group>
                    <separator string="Domain"/>
                    <group col="1" class="o_dashboard_condition_domain">
                        <field name="domain" nolabel="1" colspan="1"
                               widget="dashboard_domain"
                               class="w-100"
                               invisible="not domain_model_name"
                               options="{'model': 'domain_model_name', 'in_dialog': False, 'foldable': False, 'allow_expressions': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dashboard_condition" model="ir.actions.act_window">
        <field name="name">Conditions</field>
        <field name="res_model">dashboard.condition</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
