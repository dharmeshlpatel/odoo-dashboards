<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dashboard_blueprint_group_list" model="ir.ui.view">
        <field name="name">dashboard.blueprint.group.list</field>
        <field name="model">dashboard.blueprint.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="hub_menu_id"/>
            </list>
        </field>
    </record>

    <record id="view_dashboard_blueprint_group_form" model="ir.ui.view">
        <field name="name">dashboard.blueprint.group.form</field>
        <field name="model">dashboard.blueprint.group</field>
        <field name="arch" type="xml">
            <form string="Dashboard Group">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Sales"/>
                        </h1>
                    </div>
                    <group>
                        <field name="sequence"/>
                        <field name="hub_menu_id" options="{'no_create_edit': False}"/>
                    </group>
                    <field name="dashboard_ids">
                        <list default_order="menu_sequence, id">
                            <field name="menu_sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="key"/>
                            <field name="state"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dashboard_blueprint_group" model="ir.actions.act_window">
        <field name="name">Groups</field>
        <field name="res_model">dashboard.blueprint.group</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
