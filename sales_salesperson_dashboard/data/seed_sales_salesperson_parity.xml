<?xml version="1.0" encoding="utf-8"?>
<!-- Sales Salespersons fill — mirrors sales_customer density with user_id. -->
<odoo noupdate="1">
    <!-- Point primary at sale.report graph (same model as mini-chart after migration). -->
    <record id="blueprint_sales_salespersons" model="dashboard.blueprint">
        <field name="primary_action_xmlid">sale.action_order_report_salesperson</field>
        <field name="primary_action_domain">[]</field>
        <field name="graph_model">sale.report</field>
        <field name="graph_data_field">user_id</field>
        <field name="graph_measure">price_subtotal:sum</field>
        <field name="graph_groupby">date:month</field>
        <field name="graph_caption">Sales</field>
    </record>

    <record id="slot_sale_sp_to_deliver" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_sales_salespersons"/>
        <field name="key">to_deliver</field>
        <field name="name">To Deliver</field>
        <field name="section">kpi</field>
        <field name="sequence">25</field>
        <field name="label">Order to Deliver</field>
        <field name="label_plural">Orders to Deliver</field>
        <field name="compute_model">sale.order</field>
        <field name="relate_field">user_id</field>
        <field name="compute_domain">[('state', '=', 'sale'), ('delivery_status', '!=', 'full')]</field>
        <field name="compute_aggregator">__count</field>
        <field name="action_xmlid">sale.action_orders</field>
        <field name="action_domain">[('state', '=', 'sale'), ('delivery_status', '!=', 'full'), ('user_id', '=', '{{id}}')]</field>
        <field name="module_depends">sale,sale_stock</field>
    </record>
    <record id="slot_sale_sp_to_upsell" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_sales_salespersons"/>
        <field name="key">to_upsell</field>
        <field name="name">To Upsell</field>
        <field name="section">kpi</field>
        <field name="sequence">35</field>
        <field name="label">Order to Upsell</field>
        <field name="label_plural">Orders to Upsell</field>
        <field name="compute_model">sale.order</field>
        <field name="relate_field">user_id</field>
        <field name="compute_domain">[('invoice_status', '=', 'upselling')]</field>
        <field name="compute_aggregator">__count</field>
        <field name="action_xmlid">sale.action_orders_upselling</field>
        <field name="action_domain">[('invoice_status', '=', 'upselling'), ('user_id', '=', '{{id}}')]</field>
        <field name="module_depends">sale</field>
    </record>

    <record id="slot_sale_sp_bottom_transfers" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_sales_salespersons"/>
        <field name="key">bottom_transfers</field>
        <field name="name">Transfers Button</field>
        <field name="section">bottom</field>
        <field name="sequence">20</field>
        <field name="label">Transfers</field>
        <field name="icon">fa-truck</field>
        <field name="show_if_zero" eval="True"/>
        <field name="compute_model">stock.picking</field>
        <field name="relate_field">user_id</field>
        <field name="compute_domain">[('picking_type_id.code', 'in', ('incoming', 'outgoing'))]</field>
        <field name="action_xmlid">stock.action_picking_tree_all</field>
        <field name="action_domain">[('user_id', '=', '{{id}}'), ('picking_type_id.code', 'in', ('incoming', 'outgoing'))]</field>
        <field name="module_depends">sale,stock</field>
    </record>
    <record id="slot_sale_sp_bottom_invoices" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_sales_salespersons"/>
        <field name="key">bottom_invoices</field>
        <field name="name">Invoices Button</field>
        <field name="section">bottom</field>
        <field name="sequence">30</field>
        <field name="label">Invoices</field>
        <field name="icon">fa-pencil-square-o</field>
        <field name="show_if_zero" eval="True"/>
        <field name="groups_xmlids">account.group_account_invoice</field>
        <field name="compute_model">account.move</field>
        <field name="relate_field">invoice_user_id</field>
        <field name="compute_domain">[('move_type', 'in', ('out_invoice', 'out_refund')), ('state', '!=', 'cancel')]</field>
        <field name="action_xmlid">account.action_move_out_invoice_type</field>
        <field name="action_domain">[('invoice_user_id', '=', '{{id}}'), ('move_type', 'in', ('out_invoice', 'out_refund'))]</field>
        <field name="module_depends">sale,account</field>
    </record>

    <record id="slot_sale_sp_menu_quotations" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_sales_salespersons"/>
        <field name="key">view_quotations</field>
        <field name="name">View Quotations</field>
        <field name="section">menu_views</field>
        <field name="sequence">5</field>
        <field name="label">Quotations</field>
        <field name="show_if_zero" eval="True"/>
        <field name="action_xmlid">sale.action_quotations_with_onboarding</field>
        <field name="action_domain">[('user_id', '=', '{{id}}')]</field>
        <field name="module_depends">sale</field>
    </record>
    <record id="slot_sale_sp_menu_transfers" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_sales_salespersons"/>
        <field name="key">view_transfers</field>
        <field name="name">View Transfers</field>
        <field name="section">menu_views</field>
        <field name="sequence">20</field>
        <field name="label">Transfers</field>
        <field name="show_if_zero" eval="True"/>
        <field name="action_xmlid">stock.action_picking_tree_all</field>
        <field name="action_domain">[('user_id', '=', '{{id}}')]</field>
        <field name="module_depends">sale,stock</field>
    </record>
    <record id="slot_sale_sp_menu_invoices" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_sales_salespersons"/>
        <field name="key">view_invoices</field>
        <field name="name">View Invoices</field>
        <field name="section">menu_views</field>
        <field name="sequence">30</field>
        <field name="label">Invoices</field>
        <field name="show_if_zero" eval="True"/>
        <field name="groups_xmlids">account.group_account_invoice</field>
        <field name="action_xmlid">account.action_move_out_invoice_type</field>
        <field name="action_domain">[('invoice_user_id', '=', '{{id}}')]</field>
        <field name="module_depends">sale,account</field>
    </record>

    <record id="slot_sale_sp_menu_report_sales" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_sales_salespersons"/>
        <field name="key">report_sales</field>
        <field name="name">Report Sales</field>
        <field name="section">menu_reports</field>
        <field name="sequence">10</field>
        <field name="label">Sales</field>
        <field name="show_if_zero" eval="True"/>
        <field name="action_xmlid">sale.action_order_report_salesperson</field>
        <field name="action_domain">[('user_id', '=', '{{id}}')]</field>
        <field name="module_depends">sale</field>
    </record>
    <record id="slot_sale_sp_menu_report_invoices" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_sales_salespersons"/>
        <field name="key">report_invoices</field>
        <field name="name">Report Invoices</field>
        <field name="section">menu_reports</field>
        <field name="sequence">20</field>
        <field name="label">Invoices</field>
        <field name="show_if_zero" eval="True"/>
        <field name="groups_xmlids">account.group_account_invoice</field>
        <field name="action_xmlid">account.action_account_invoice_report_all</field>
        <field name="action_domain">[('invoice_user_id', '=', '{{id}}')]</field>
        <field name="module_depends">sale,account</field>
    </record>
</odoo>
