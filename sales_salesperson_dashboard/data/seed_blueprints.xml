<?xml version="1.0" encoding="utf-8"?>
<!--
  Sales Salespersons dashboard on res.users (sales twin of crm_salesperson_dashboard).
  Card link: user_id on sale.order (no _enterprise suffix).
-->
<odoo noupdate="1">
    <record id="blueprint_sales_salespersons" model="dashboard.blueprint">
        <field name="name">Sales Salespersons</field>
        <field name="key">sales_salespersons</field>
        <field name="host_model_id" ref="base.model_res_users"/>
        <field name="module_depends">sale</field>
        <field name="menu_name">Salespersons Dashboard</field>
        <field name="menu_parent_xmlid">sale.sale_menu_root</field>
        <field name="menu_sequence">6</field>
        <field name="primary_button_label">Sales Analysis</field>
        <field name="primary_action_xmlid">sale.action_orders</field>
        <field name="graph_model">sale.order</field>
        <field name="graph_data_field">user_id</field>
        <field name="graph_measure">amount_total:sum</field>
        <field name="graph_groupby">date_order:month</field>
        <field name="graph_domain">[]</field>
        <field name="graph_caption">Sales Orders</field>
        <field name="include_child_records" eval="False"/>
        <field name="lens_my_enabled" eval="False"/>
        <field name="lens_kpis_enabled" eval="True"/>
        <field name="lens_kpis_default" eval="True"/>
        <field name="lens_kpis_label">With KPIs</field>
        <field name="state">published</field>
        <field name="sequence">16</field>
    </record>

    <record id="scope_sale_sp_orders" model="dashboard.blueprint.scope">
        <field name="blueprint_id" ref="blueprint_sales_salespersons"/>
        <field name="sequence">10</field>
        <field name="name">Sales Orders</field>
        <field name="mode">include</field>
        <field name="domain">[('state', 'in', ('sale', 'done'))]</field>
        <field name="default_on" eval="True"/>
    </record>
    <record id="scope_sale_sp_quotations" model="dashboard.blueprint.scope">
        <field name="blueprint_id" ref="blueprint_sales_salespersons"/>
        <field name="sequence">20</field>
        <field name="name">Quotations</field>
        <field name="mode">include</field>
        <field name="domain">[('state', 'in', ('draft', 'sent'))]</field>
        <field name="default_on" eval="False"/>
    </record>
    <record id="scope_sale_sp_mine" model="dashboard.blueprint.scope">
        <field name="blueprint_id" ref="blueprint_sales_salespersons"/>
        <field name="sequence">30</field>
        <field name="name">My Orders</field>
        <field name="mode">restrict</field>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="default_on" eval="False"/>
    </record>

    <record id="slot_sale_sp_quotations" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_sales_salespersons"/>
        <field name="key">quotations</field>
        <field name="name">Quotations</field>
        <field name="section">kpi</field>
        <field name="sequence">10</field>
        <field name="label">Quotation</field>
        <field name="label_plural">Quotations</field>
        <field name="compute_model">sale.order</field>
        <field name="relate_field">user_id</field>
        <field name="compute_domain">[('state', 'in', ('draft', 'sent'))]</field>
        <field name="compute_aggregator">__count</field>
        <field name="amount_aggregator">amount_total:sum</field>
        <field name="action_xmlid">sale.action_quotations_with_onboarding</field>
        <field name="action_domain">[('state', 'in', ('draft', 'sent')), ('user_id', '=', '{{id}}')]</field>
        <field name="module_depends">sale</field>
    </record>
    <record id="slot_sale_sp_orders" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_sales_salespersons"/>
        <field name="key">sales_orders</field>
        <field name="name">Sales Orders</field>
        <field name="section">kpi</field>
        <field name="sequence">20</field>
        <field name="label">Sales Order</field>
        <field name="label_plural">Sales Orders</field>
        <field name="compute_model">sale.order</field>
        <field name="relate_field">user_id</field>
        <field name="compute_domain">[('state', 'in', ('sale', 'done'))]</field>
        <field name="compute_aggregator">__count</field>
        <field name="amount_aggregator">amount_total:sum</field>
        <field name="action_xmlid">sale.action_orders</field>
        <field name="action_domain">[('state', 'in', ('sale', 'done')), ('user_id', '=', '{{id}}')]</field>
        <field name="module_depends">sale</field>
    </record>
    <record id="slot_sale_sp_to_invoice" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_sales_salespersons"/>
        <field name="key">to_invoice</field>
        <field name="name">To Invoice</field>
        <field name="section">kpi</field>
        <field name="sequence">30</field>
        <field name="label">Order to Invoice</field>
        <field name="label_plural">Orders to Invoice</field>
        <field name="compute_model">sale.order</field>
        <field name="relate_field">user_id</field>
        <field name="compute_domain">[('invoice_status', '=', 'to invoice')]</field>
        <field name="compute_aggregator">__count</field>
        <field name="action_xmlid">sale.action_orders_to_invoice</field>
        <field name="action_domain">[('invoice_status', '=', 'to invoice'), ('user_id', '=', '{{id}}')]</field>
        <field name="module_depends">sale</field>
    </record>
    <record id="slot_sale_sp_menu_orders" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_sales_salespersons"/>
        <field name="key">view_orders</field>
        <field name="name">View Orders</field>
        <field name="section">menu_views</field>
        <field name="sequence">10</field>
        <field name="label">Orders</field>
        <field name="show_if_zero" eval="True"/>
        <field name="action_xmlid">sale.action_orders</field>
        <field name="action_domain">[('user_id', '=', '{{id}}')]</field>
        <field name="module_depends">sale</field>
    </record>
    <record id="slot_sale_sp_menu_new_quotation" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_sales_salespersons"/>
        <field name="key">new_quotation</field>
        <field name="name">New Quotation</field>
        <field name="section">menu_new</field>
        <field name="sequence">10</field>
        <field name="label">Quotation</field>
        <field name="show_if_zero" eval="True"/>
        <field name="action_xmlid">sale.action_quotations_with_onboarding</field>
        <field name="action_context">{"default_user_id": {{id}}}</field>
        <field name="module_depends">sale</field>
    </record>
    <record id="slot_sale_sp_bottom" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_sales_salespersons"/>
        <field name="key">bottom_sales</field>
        <field name="name">Sales Button</field>
        <field name="section">bottom</field>
        <field name="sequence">10</field>
        <field name="label">Sales</field>
        <field name="icon">fa-usd</field>
        <field name="show_if_zero" eval="True"/>
        <field name="groups_xmlids">sales_team.group_sale_salesman</field>
        <field name="compute_model">sale.order</field>
        <field name="relate_field">user_id</field>
        <field name="compute_domain">[('state', '!=', 'cancel')]</field>
        <field name="action_xmlid">sale.action_orders</field>
        <field name="action_domain">[('user_id', '=', '{{id}}')]</field>
        <field name="action_context">{"search_default_user_id": [{{id}}], "default_user_id": {{id}}}</field>
        <field name="module_depends">sale,sales_team</field>
    </record>
</odoo>
