<?xml version="1.0" encoding="utf-8"?>
<!-- Sales Team card headers (crm.team). -->
<odoo noupdate="1">
    <record id="blueprint_crm_sales_team" model="dashboard.blueprint">
        <field name="header_title_field">name</field>
    </record>
    <record id="header_crm_team_company" model="dashboard.blueprint.header.item">
        <field name="blueprint_id" ref="blueprint_crm_sales_team"/>
        <field name="sequence">10</field>
        <field name="kind">subtitle</field>
        <field name="alignment">left</field>
        <field name="field_names">company_id</field>
    </record>

    <record id="blueprint_sales_team" model="dashboard.blueprint">
        <field name="header_title_field">name</field>
    </record>
    <record id="header_sale_team_company" model="dashboard.blueprint.header.item">
        <field name="blueprint_id" ref="blueprint_sales_team"/>
        <field name="sequence">10</field>
        <field name="kind">subtitle</field>
        <field name="alignment">left</field>
        <field name="field_names">company_id</field>
    </record>
</odoo>
