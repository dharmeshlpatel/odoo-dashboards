<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="blueprint_product_360" model="dashboard.blueprint">
        <field name="name">Product 360</field>
        <field name="key">product_360</field>
        <field name="host_model_id" ref="product.model_product_product"/>
        <field name="module_depends">sale,product</field>
        <field name="menu_name">Product 360</field>
        <field name="menu_parent_xmlid">sale.menu_sale_report</field>
        <field name="menu_sequence">8</field>
        <field name="primary_button_label">Sales Analysis</field>
        <field name="primary_action_xmlid">sale.action_order_report_all</field>
        <field name="graph_model">sale.report</field>
        <field name="graph_data_field">product_id</field>
        <field name="graph_measure">price_subtotal:sum</field>
        <field name="graph_groupby">date:month</field>
        <field name="graph_caption">Product sales</field>
        <field name="lens_my_enabled" eval="False"/>
        <field name="lens_kpis_enabled" eval="True"/>
        <field name="lens_kpis_default" eval="True"/>
        <field name="lens_kpis_label">With KPIs</field>
        <field name="lens_attention_enabled" eval="True"/>
        <field name="lens_attention_default" eval="True"/>
        <field name="lens_attention_label">Needs attention</field>
        <field name="state">draft</field>
        <field name="sequence">8</field>
    </record>
    <record id="scope_p360_orders" model="dashboard.blueprint.scope">
        <field name="blueprint_id" ref="blueprint_product_360"/>
        <field name="sequence">10</field>
        <field name="name">Sales Orders</field>
        <field name="mode">include</field>
        <field name="domain">[('state', 'in', ('sale', 'done'))]</field>
        <field name="default_on" eval="True"/>
    </record>
</odoo>
