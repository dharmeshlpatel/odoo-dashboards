<?xml version="1.0" encoding="utf-8"?>
<!-- Default Chart model picker option(s) (mirrors blueprint graph / primary). -->
<odoo noupdate="1">
    <record id="graph_variant_website_360_sale_order" model="dashboard.blueprint.graph.variant">
        <field name="blueprint_id" ref="blueprint_website_360"/>
        <field name="sequence">10</field>
        <field name="is_default" eval="True"/>
        <field name="graph_model">sale.order</field>
        <field name="graph_data_field">website_id</field>
        <field name="primary_button_label">Orders</field>
        <field name="primary_action_xmlid">sale.action_orders</field>
        <field name="primary_action_context">{}</field>
    </record>

</odoo>
