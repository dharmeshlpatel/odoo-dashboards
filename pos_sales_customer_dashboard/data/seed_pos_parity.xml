<?xml version="1.0" encoding="utf-8"?>
<!-- POS customer dashboard fill (v1 pos_sales_customer_dashboard_enterprise). -->
<odoo noupdate="1">
    <record id="scope_pos_orders" model="dashboard.blueprint.scope">
        <field name="blueprint_id" ref="blueprint_pos_customers"/>
        <field name="sequence">10</field>
        <field name="name">POS Orders</field>
        <field name="mode">include</field>
        <field name="domain">[('state', '!=', 'cancel')]</field>
        <field name="default_on" eval="True"/>
    </record>
    <record id="scope_pos_mine" model="dashboard.blueprint.scope">
        <field name="blueprint_id" ref="blueprint_pos_customers"/>
        <field name="sequence">20</field>
        <field name="name">Only mine</field>
        <field name="mode">restrict</field>
        <field name="restrict_kind">mine</field>
        <field name="merge_noun">POS orders</field>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="default_on" eval="False"/>
    </record>

    <record id="slot_pos_to_invoice" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_pos_customers"/>
        <field name="key">pos_to_invoice</field>
        <field name="name">POS To Invoice</field>
        <field name="section">kpi</field>
        <field name="sequence">20</field>
        <field name="label">Order to Invoice</field>
        <field name="label_plural">Orders to Invoice</field>
        <field name="compute_model">pos.order</field>
        <field name="relate_field">partner_id</field>
        <field name="compute_domain">[('state', '=', 'paid')]</field>
        <field name="compute_aggregator">__count</field>
        <field name="action_model">pos.order</field>
        <field name="action_domain">[('state', '=', 'paid'), ('partner_id', '=', '{{id}}')]</field>
        <field name="module_depends">point_of_sale</field>
    </record>

    <record id="slot_pos_menu_orders" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_pos_customers"/>
        <field name="key">view_pos_orders</field>
        <field name="name">View POS Orders</field>
        <field name="section">menu_views</field>
        <field name="sequence">10</field>
        <field name="label">POS Orders</field>
        <field name="show_if_zero" eval="True"/>
        <field name="action_xmlid">point_of_sale.action_pos_pos_form</field>
        <field name="action_domain">[('partner_id', '=', '{{id}}')]</field>
        <field name="module_depends">point_of_sale</field>
    </record>
</odoo>
