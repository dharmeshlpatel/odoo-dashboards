<?xml version="1.0" encoding="utf-8"?>
<!--
  CRM Salespersons header lines (res.users host fields).
-->
<odoo noupdate="1">
    <record id="blueprint_crm_salespersons" model="dashboard.blueprint">
        <field name="header_title_field">name</field>
        <field name="header_image_field">image_128</field>
        <field name="header_image_style">avatar</field>
    </record>

    <record id="header_crm_sp_login" model="dashboard.blueprint.header.item">
        <field name="blueprint_id" ref="blueprint_crm_salespersons"/>
        <field name="sequence">10</field>
        <field name="kind">subtitle</field>
        <field name="alignment">left</field>
        <field name="field_names">login</field>
    </record>

    <record id="header_crm_sp_email" model="dashboard.blueprint.header.item">
        <field name="blueprint_id" ref="blueprint_crm_salespersons"/>
        <field name="sequence">20</field>
        <field name="kind">inline</field>
        <field name="alignment">left</field>
        <field name="icon">fa-envelope</field>
        <field name="field_names">email</field>
    </record>

    <record id="header_crm_sp_phone" model="dashboard.blueprint.header.item">
        <field name="blueprint_id" ref="blueprint_crm_salespersons"/>
        <field name="sequence">30</field>
        <field name="kind">inline</field>
        <field name="alignment">left</field>
        <field name="icon">fa-phone</field>
        <field name="field_names">phone</field>
    </record>
</odoo>
