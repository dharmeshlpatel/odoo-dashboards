<?xml version="1.0" encoding="utf-8"?>
<!-- POS Products fill. -->
<odoo noupdate="1">
    <record id="blueprint_pos_products" model="dashboard.blueprint">
        <field name="primary_button_label">POS Analysis</field>
        <field name="primary_action_xmlid">point_of_sale.action_report_pos_order_all</field>
        <field name="primary_action_domain">[]</field>
        <field name="graph_model">report.pos.order</field>
        <field name="graph_data_field">product_id</field>
        <field name="graph_measure">price_total:sum</field>
        <field name="graph_groupby">date:month</field>
        <field name="graph_caption">POS Sales</field>
    </record>

    <record id="slot_pos_prod_kpi_refunds" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_pos_products"/>
        <field name="key">pos_refund_lines</field>
        <field name="name">Refunds</field>
        <field name="section">kpi</field>
        <field name="sequence">20</field>
        <field name="label">Refund</field>
        <field name="label_plural">Refunds</field>
        <field name="compute_model">pos.order.line</field>
        <field name="relate_field">product_id</field>
        <field name="compute_domain">[('order_id.amount_total', '&lt;', 0)]</field>
        <field name="compute_aggregator">order_id:count_distinct</field>
        <field name="action_xmlid">point_of_sale.action_pos_pos_form</field>
        <field name="action_domain">[('lines.product_id', '=', '{{id}}'), ('amount_total', '&lt;', 0)]</field>
        <field name="module_depends">point_of_sale,product</field>
    </record>

    <record id="slot_pos_prod_box_on_hand" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_pos_products"/>
        <field name="key">box_on_hand</field>
        <field name="name">On Hand</field>
        <field name="section">button_box</field>
        <field name="sequence">10</field>
        <field name="label">On Hand</field>
        <field name="icon">fa-cubes</field>
        <field name="show_if_zero" eval="True"/>
        <field name="amount_field">qty_available</field>
        <field name="action_method">action_open_quants</field>
        <field name="module_depends">point_of_sale,stock</field>
    </record>
    <record id="slot_pos_prod_box_reserved" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_pos_products"/>
        <field name="key">box_reserved</field>
        <field name="name">Reserved</field>
        <field name="section">button_box</field>
        <field name="sequence">15</field>
        <field name="label">Reserved</field>
        <field name="icon">fa-lock</field>
        <field name="show_if_zero" eval="True"/>
        <field name="style">warning</field>
        <field name="style_mode">when_positive</field>
        <field name="is_attention_signal" eval="True"/>
        <field name="value_mode">amount</field>
        <field name="compute_model">stock.quant</field>
        <field name="relate_field">product_id</field>
        <field name="compute_domain">[('location_id.usage', '=', 'internal'), ('reserved_quantity', '&gt;', 0)]</field>
        <field name="compute_aggregator">__count</field>
        <field name="amount_aggregator">reserved_quantity:sum</field>
        <field name="module_depends">point_of_sale,stock</field>
    </record>

    <record id="slot_pos_prod_menu_orders" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_pos_products"/>
        <field name="key">view_pos_orders</field>
        <field name="name">View POS Orders</field>
        <field name="section">menu_views</field>
        <field name="sequence">20</field>
        <field name="label">Orders</field>
        <field name="show_if_zero" eval="True"/>
        <field name="action_xmlid">point_of_sale.action_pos_pos_form</field>
        <field name="action_domain">[('lines.product_id', '=', '{{id}}')]</field>
        <field name="module_depends">point_of_sale,product</field>
    </record>
    <record id="slot_pos_prod_menu_report" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_pos_products"/>
        <field name="key">report_pos</field>
        <field name="name">Report POS</field>
        <field name="section">menu_reports</field>
        <field name="sequence">10</field>
        <field name="label">POS</field>
        <field name="show_if_zero" eval="True"/>
        <field name="action_xmlid">point_of_sale.action_report_pos_order_all</field>
        <field name="action_domain">[('product_id', '=', '{{id}}')]</field>
        <field name="module_depends">point_of_sale,product</field>
    </record>
</odoo>
