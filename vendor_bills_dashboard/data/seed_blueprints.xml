<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="blueprint_vendor_bills" model="dashboard.blueprint">
        <field name="name">Vendor Bills</field>
        <field name="key">vendor_bills</field>
        <field name="host_model_id" ref="base.model_res_partner"/>
        <field name="module_depends">account</field>
        <field name="menu_name">Vendors Dashboard</field>
        <field name="menu_parent_xmlid">account.menu_finance_reports</field>
        <field name="menu_sequence">5</field>
        <field name="primary_button_label">Bill Analysis</field>
        <field name="primary_action_xmlid">account.action_account_invoice_report_all</field>
        <field name="graph_model">account.invoice.report</field>
        <field name="graph_data_field">partner_id</field>
        <field name="graph_measure">price_subtotal:sum</field>
        <field name="graph_groupby">invoice_date:month</field>
        <field name="graph_domain">[('move_type', '=', 'in_invoice')]</field>
        <field name="graph_caption">Vendor bills</field>

        <field name="lens_my_enabled" eval="True"/>
        <field name="lens_my_default" eval="False"/>
        <field name="lens_my_label">My records</field>
        <field name="lens_kpis_enabled" eval="True"/>
        <field name="lens_kpis_default" eval="True"/>
        <field name="lens_kpis_label">With KPIs</field>

        <field name="lens_attention_enabled" eval="True"/>
        <field name="lens_attention_default" eval="True"/>
        <field name="lens_attention_label">Needs attention</field>
        <field name="state">draft</field>
        <field name="sequence">90</field>
    </record>

    <record id="slot_vendor_to_pay" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_vendor_bills"/>
        <field name="key">bills_to_pay</field>
        <field name="name">To Pay</field>
        <field name="section">kpi</field>
        <field name="sequence">10</field>
        <field name="label">Bill to Pay</field>
        <field name="label_plural">Bills to Pay</field>
        <field name="compute_model">account.move</field>
        <field name="relate_field">partner_id</field>
        <field name="compute_domain">[('move_type', '=', 'in_invoice'), ('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial', 'in_payment'))]</field>
        <field name="compute_aggregator">__count</field>
        <field name="action_xmlid">account.action_move_in_invoice_type</field>
        <field name="action_domain">[('partner_id', '=', '{{id}}'), ('move_type', '=', 'in_invoice'), ('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial', 'in_payment'))]</field>
    </record>
    <record id="slot_vendor_overdue" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_vendor_bills"/>
        <field name="key">bills_overdue</field>
        <field name="name">Overdue Bills</field>
        <field name="section">kpi</field>
        <field name="sequence">20</field>
        <field name="label">Overdue Bill</field>
        <field name="label_plural">Overdue Bills</field>
        <field name="style">danger</field>
        <field name="style_mode">when_positive</field>
        <field name="is_attention_signal" eval="True"/>
        <field name="compute_model">account.move</field>
        <field name="relate_field">partner_id</field>
        <field name="compute_domain">[('move_type', '=', 'in_invoice'), ('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial', 'in_payment'))]</field>
        <field name="condition_ids" eval="[(4, ref('condition_vendor_overdue_due_date'))]"/>
        <field name="compute_aggregator">__count</field>
        <field name="action_xmlid">account.action_move_in_invoice_type</field>
        <field name="action_domain">[('partner_id', '=', '{{id}}'), ('move_type', '=', 'in_invoice')]</field>
    </record>
    <record id="slot_vendor_draft" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_vendor_bills"/>
        <field name="key">bills_draft</field>
        <field name="name">Draft Bills</field>
        <field name="section">kpi</field>
        <field name="sequence">30</field>
        <field name="label">Draft Bill</field>
        <field name="label_plural">Draft Bills</field>
        <field name="compute_model">account.move</field>
        <field name="relate_field">partner_id</field>
        <field name="compute_domain">[('move_type', '=', 'in_invoice'), ('state', '=', 'draft')]</field>
        <field name="compute_aggregator">__count</field>
        <field name="action_xmlid">account.action_move_in_invoice_type</field>
        <field name="action_domain">[('partner_id', '=', '{{id}}'), ('move_type', '=', 'in_invoice'), ('state', '=', 'draft')]</field>
    </record>
    <record id="slot_vendor_bottom_bills" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_vendor_bills"/>
        <field name="key">bottom_bills</field>
        <field name="name">Bills</field>
        <field name="section">bottom</field>
        <field name="sequence">10</field>
        <field name="label">Bills</field>
        <field name="icon">fa-file-text-o</field>
        <field name="show_if_zero" eval="True"/>
        <field name="compute_model">account.move</field>
        <field name="relate_field">partner_id</field>
        <field name="compute_domain">[('move_type', '=', 'in_invoice')]</field>
        <field name="action_xmlid">account.action_move_in_invoice_type</field>
        <field name="action_domain">[('partner_id', '=', '{{id}}'), ('move_type', '=', 'in_invoice')]</field>
    </record>
    <record id="slot_vendor_view_bills" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_vendor_bills"/>
        <field name="key">view_bills</field>
        <field name="name">View Bills</field>
        <field name="section">menu_views</field>
        <field name="sequence">10</field>
        <field name="label">Bills</field>
        <field name="show_if_zero" eval="True"/>
        <field name="action_xmlid">account.action_move_in_invoice_type</field>
        <field name="action_domain">[('partner_id', '=', '{{id}}')]</field>
    </record>
    <record id="slot_vendor_new_bill" model="dashboard.blueprint.slot">
        <field name="blueprint_id" ref="blueprint_vendor_bills"/>
        <field name="key">new_bill</field>
        <field name="name">New Bill</field>
        <field name="section">menu_new</field>
        <field name="sequence">10</field>
        <field name="label">Bill</field>
        <field name="show_if_zero" eval="True"/>
        <field name="action_xmlid">account.action_move_in_invoice_type</field>
        <field name="action_context">{"default_move_type": "in_invoice", "default_partner_id": "{{id}}"}</field>
    </record>
</odoo>
